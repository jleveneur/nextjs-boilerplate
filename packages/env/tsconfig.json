{
  "extends": "@repo/tsconfig/library.json",
  "compilerOptions": {
    // This package is the sole authorised reader of process.env, so it needs the
    // Node ambient types. Browser-safety of the client/shared entries is enforced
    // by the export split and by server-only on the server entry — not by omitting
    // the type.
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
