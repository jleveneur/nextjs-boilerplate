{
  "name": "@repo/storage",
  "version": "0.0.0",
  "private": true,
  "description": "S3-compatible object storage with presigned URLs, byte I/O, and Sharp derivatives.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@repo/utils": "workspace:*",
    "server-only": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repo": {
    "layer": 1,
    "runtime": "node"
  }
}
