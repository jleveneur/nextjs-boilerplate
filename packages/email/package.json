{
  "name": "@repo/email",
  "version": "0.0.0",
  "private": true,
  "description": "Mailer port with Resend, SMTP (Mailpit), NoopMailer, and React Email templates.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./emails/*": "./src/emails/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "email:dev": "email dev --dir src/emails --port 3005"
  },
  "dependencies": {
    "@react-email/components": "catalog:",
    "@react-email/render": "catalog:",
    "@repo/utils": "workspace:*",
    "nodemailer": "catalog:",
    "react": "catalog:",
    "resend": "catalog:",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.1",
    "@repo/tsconfig": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "react-dom": "catalog:",
    "react-email": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repo": {
    "layer": 1,
    "runtime": "node"
  }
}
