{
  "name": "@repo/analytics",
  "version": "0.0.0",
  "private": true,
  "description": "Typed product-event registry and server/client capture adapters (PostHog).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events.ts",
    "./client": "./src/client.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/utils": "workspace:*",
    "posthog-js": "catalog:",
    "posthog-node": "catalog:",
    "server-only": "0.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repo": {
    "layer": 1,
    "runtime": "node"
  }
}
