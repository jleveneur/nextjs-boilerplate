# Docs site (`@repo/docs`) — public bake-time values only.
# Copied to `.env` by `make setup` (or: cp apps/docs/.env.example apps/docs/.env).
# `make dev` serves this at https://docs.localhost via Portless.
# No secrets, DB, or Redis — see packages/env publicApp preset.

NEXT_PUBLIC_APP_URL=https://docs.localhost
NEXT_PUBLIC_APP_ENV=local
