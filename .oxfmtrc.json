{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "tabWidth": 2,
  "useTabs": false,
  "sortImports": {
    "internalPattern": ["@/"],
    "newlinesBetween": true,
    "customGroups": [
      {
        "groupName": "repo",
        "elementNamePattern": ["@repo", "@repo/**"]
      }
    ],
    "groups": [
      "side_effect",
      "builtin",
      "external",
      "repo",
      "internal",
      ["parent", "sibling", "index"],
      "side_effect_style",
      "style",
      "unknown"
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.next/**",
    "**/coverage/**",
    "**/node_modules/**",
    "pnpm-lock.yaml",
    "**/*.generated.*",
    "**/openapi.json"
  ]
}
