# Placeholder catalog for a staging-shaped deploy.
# Copy values into your platform's secret store — never commit real secrets.
# Full catalog: docs/architecture/09-environment-and-secrets.md §5

NODE_ENV=production
APP_ENV=staging
APP_URL=https://staging.example.com
LOG_LEVEL=info

# Baked into the web image at build time — rebuild if these change.
NEXT_PUBLIC_APP_URL=https://staging.example.com
NEXT_PUBLIC_APP_ENV=staging

DATABASE_URL=postgres://USER:PASSWORD@db.example.com:5432/app_staging
DATABASE_POOL_SIZE=10

REDIS_URL=rediss://USER:PASSWORD@redis.example.com:6379

S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=app-staging
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

RESEND_API_KEY=re_replace_me
EMAIL_FROM=noreply@example.com
# SMTP_URL=   # unset in staging unless you use a catcher

BETTER_AUTH_SECRET=replace-with-at-least-32-random-chars
BETTER_AUTH_URL=https://staging.example.com
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
SENTRY_ENABLED=false
# SENTRY_DSN=

# Migrate job only needs base + db (DATABASE_URL, APP_*, NODE_ENV, LOG_LEVEL).
# Do not set SKIP_ENV_VALIDATION at runtime.
