# Placeholder catalog for a staging-shaped deploy.
# Copy values into your platform's secret store — never commit real secrets.
# Full catalog: docs/architecture/09-environment-and-secrets.md §5
#
# When APP_ENV=staging, @repo/env rejects localhost URLs, "dev-" secrets,
# and Stripe test keys — same bar as production.
#
# The three `*.example` files list the same keys in the same order; only values
# and which lines are uncommented differ per environment.

NODE_ENV=production
APP_ENV=staging
APP_URL=https://staging.example.com
LOG_LEVEL=info

# Public client values — baked into the web / docs images at build time.
# Rebuild if these change.
NEXT_PUBLIC_APP_URL=https://staging.example.com
NEXT_PUBLIC_APP_ENV=staging

# Database
DATABASE_URL=postgres://USER:PASSWORD@db.example.com:5432/app_staging
DATABASE_POOL_SIZE=10

# Redis — use rediss:// when TLS is required.
REDIS_URL=rediss://USER:PASSWORD@redis.example.com:6379

# S3-compatible object storage (R2, MinIO, …). Endpoint is required.
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=app-staging
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Email — Resend in deployed envs. Leave SMTP/Mailpit unset unless you use a catcher.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=noreply@example.com
# SMTP_URL=
# MAILPIT_API_URL=

# Auth — Better Auth secret must be ≥32 chars. OAuth optional until those providers are offered.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-chars
BETTER_AUTH_URL=https://staging.example.com
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OpenTelemetry
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
# OTEL_SERVICE_NAME=app

# Sentry — one project across web/api/worker (filter by the `service` tag).
# Runtime: SENTRY_DSN (server) and NEXT_PUBLIC_SENTRY_DSN (browser).
# CI source maps: SENTRY_ORG, SENTRY_PROJECT, secret SENTRY_AUTH_TOKEN.
SENTRY_ENABLED=false
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
# SENTRY_RELEASE=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog — server capture; browser key is NEXT_PUBLIC_*.
# EU cloud uses eu.i.posthog.com; US cloud uses us.i.posthog.com.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Feature flags — JSON overrides (PostHog provider used when API key is set).
# FLAGS_JSON={"new-billing-portal":true}

# Stripe Billing. Staging and production reject Stripe test keys (sk_test_ / pk_test_).
# STRIPE_SECRET_KEY=rk_live_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me

# Process ports — defaults; set only to override.
# PORT=3000
# HOSTNAME=0.0.0.0
# API_PORT=3001
# WORKER_PORT=3002
# OUTBOX_POLL_MS=1000

# Image builds may set SKIP_ENV_VALIDATION (value 1) when secrets are absent.
# Never set it at runtime. The migrate job needs base + db only.
