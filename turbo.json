{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".npmrc",
    ".oxlintrc.json",
    "tooling/oxlint/*.json",
    "tooling/tailwind/*.css",
    "tooling/typescript/*.json"
  ],
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": ["FORCE_COLOR", "TERM"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*"],
      "outputs": [".next/**", "!.next/cache/**"],
      // `next build` evaluates route modules, which validate the environment.
      // The values do not end up in the output — no NEXT_PUBLIC_* variable
      // exists — but they must be present for the build to run at all.
      "env": ["DATABASE_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },

    // typecheck and test declare no dependencies so they fan out across every
    // package in parallel. That is only correct because internal packages ship
    // TypeScript source with no build step; the moment a package emits
    // declarations, typecheck would need "dependsOn": ["^build"].
    "typecheck": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": ["*.tsbuildinfo"]
    },

    "test": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
