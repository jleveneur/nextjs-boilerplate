{
  "name": "@repo/vitest-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Vitest configuration. Consumed by the build, never imported by shipped code.",
  "files": [
    "base.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./base.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "repo": {
    "layer": "tooling",
    "runtime": "build"
  }
}
