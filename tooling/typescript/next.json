{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js application",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "preserve",
    "types": ["node"],
    "plugins": [{ "name": "next" }],

    // Next resolves modules itself and needs bundler semantics.
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "incremental": true
  }
}
