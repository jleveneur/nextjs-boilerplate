{
  "name": "@repo/root",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal production-ready Next.js monorepo starter.",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "pnpm --filter @repo/web typegen && oxlint --type-aware",
    "lint:fix": "pnpm --filter @repo/web typegen && oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "react-doctor": "react-doctor --no-telemetry --no-supply-chain --yes",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm react-doctor && pnpm test",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "prepare": "node scripts/install-hooks.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@types/node": "catalog:",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-doctor": "0.9.13",
    "turbo": "2.10.11",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.3.0"
}
