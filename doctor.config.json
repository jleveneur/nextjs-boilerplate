{
  "$schema": "https://react.doctor/schema/config.json",
  "projects": ["apps/web", "apps/docs", "packages/ui"],
  "blocking": "error",
  "scope": "full",
  "share": false,
  "noScore": true,
  "adoptExistingLintConfig": false,
  "supplyChain": {
    "enabled": false
  },
  "ignore": {
    "files": [
      "**/.next/**",
      "**/dist/**",
      "**/*.generated.*",
      "apps/docs/.source/**",
      "apps/docs/content/docs/architecture/**",
      "apps/docs/content/docs/adr/**",
      "apps/docs/content/docs/runbooks/**"
    ]
  }
}
