{
  "$schema": "https://react.doctor/schema/config.json",
  "projects": ["apps/web", "packages/ui"],
  "blocking": "error",
  "scope": "full",
  "share": false,
  "noScore": true,
  "adoptExistingLintConfig": false,
  "supplyChain": {
    "enabled": false
  },
  "ignore": {
    "files": ["**/.next/**", "**/dist/**", "**/*.generated.*"]
  }
}
