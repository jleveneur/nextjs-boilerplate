# Placeholder catalog for a production-shaped deploy.
# Copy values into your platform's secret store — never commit real secrets.
# Full catalog: docs/architecture/09-environment-and-secrets.md §5
#
# When APP_ENV=production, @repo/env rejects localhost URLs, "dev-" secrets,
# and Stripe test keys.

NODE_ENV=production
APP_ENV=production
APP_URL=https://app.example.com
LOG_LEVEL=info

# Baked into the web image at build time — keep the public set minimal so one
# image can be promoted from staging when these match (or serve differing
# public values from a runtime endpoint).
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_APP_ENV=production

DATABASE_URL=postgres://USER:PASSWORD@db.example.com:5432/app
DATABASE_POOL_SIZE=10

REDIS_URL=rediss://USER:PASSWORD@redis.example.com:6379

S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=app-production
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

RESEND_API_KEY=re_replace_me
EMAIL_FROM=noreply@example.com

BETTER_AUTH_SECRET=replace-with-at-least-32-random-chars
BETTER_AUTH_URL=https://app.example.com
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
# OTEL_SERVICE_NAME=app

SENTRY_ENABLED=false
# Sentry — error tracking. One project across all apps (distinguished by the `service` tag).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# (Optional per-service overrides: SENTRY_DSN_API, SENTRY_DSN_WORKER, SENTRY_DSN_WEB)

# PostHog — server capture + browser key (EU: eu.i.posthog.com).
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Feature flags — JSON overrides; PostHog provider used when API key is set.
# FLAGS_JSON={"new-billing-portal":false}

# STRIPE_SECRET_KEY=sk_live_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Migrate job only needs base + db. Never set SKIP_ENV_VALIDATION at runtime.
