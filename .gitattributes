# Normalise line endings on checkin. Without this, a Windows contributor produces
# CRLF diffs that make every file look changed.
* text=auto eol=lf

# Files that must keep LF regardless of platform.
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Generated: excluded from language statistics and collapsed in review, so a
# lockfile bump does not bury the actual change. The migration SQL itself stays
# diffable — it is reviewed like any other change.
pnpm-lock.yaml linguist-generated=true -diff
packages/db/migrations/meta/** linguist-generated=true -diff

# Binary — never diff or merge these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
