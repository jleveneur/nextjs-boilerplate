# Copy to `.env` for local scripts (`make db-migrate`, seeds, integration tests).
# Apps will compose their own env modules; this file is for package CLIs.

NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Public client values (inlined into the Next.js bundle).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# Dev database (`make db-up` → host port 55432).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/app
DATABASE_POOL_SIZE=10

# Redis (`make deps-up` → host port 55434). Test stack uses 55435.
REDIS_URL=redis://127.0.0.1:55434

# S3 / MinIO (`make deps-up` → API 55436, console 55437).
S3_ENDPOINT=http://127.0.0.1:55436
S3_REGION=auto
S3_BUCKET=app
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Email — Resend in deployed envs; local SMTP targets Mailpit (55438 / UI 55439).
RESEND_API_KEY=re_test_replace_me
EMAIL_FROM=noreply@example.com
SMTP_URL=smtp://127.0.0.1:55438
MAILPIT_API_URL=http://127.0.0.1:55439

# Auth — Better Auth secret must be ≥32 chars. OAuth optional locally.
BETTER_AUTH_SECRET=dev-local-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Observability — off by default for quiet local loops.
OTEL_ENABLED=false
SENTRY_ENABLED=false
