# Local laptop catalog. `make setup` copies this to `.env`.
# Used by package CLIs (`make db-migrate`, seeds) and by api/worker via `--env-file`.
# Next.js loads `.env*` from `apps/web/` (copy or symlink this file there).
# Docs has its own file: `apps/docs/.env.example` → `apps/docs/.env`.
# Full catalog: docs/architecture/09-environment-and-secrets.md §5
#
# `make dev` wraps apps in Portless (HTTPS `*.localhost`, typically :443 so
# the URL has no port). Product origin: https://web.localhost
# (docs: https://docs.localhost). `PORTLESS=0` → localhost:3000–3003.
#
# Local service ports (`make deps-up`): Postgres 55432, Redis 55434 (test 55435),
# MinIO 55436/55437, Mailpit 55438/55439, OTLP 55444/55445, Jaeger 55443,
# Prometheus 55447, Grafana 55448 (admin/admin).
#
# The three `*.example` files share one body: same keys, same order, same section
# comments. Only values and which assignment lines are uncommented differ.

NODE_ENV=development
APP_ENV=local
APP_URL=https://web.localhost
LOG_LEVEL=info

# Public client values — baked into the web / docs images at build time.
NEXT_PUBLIC_APP_URL=https://web.localhost
NEXT_PUBLIC_APP_ENV=local

# Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/app
DATABASE_POOL_SIZE=10

# Redis — use rediss:// when TLS is required.
REDIS_URL=redis://127.0.0.1:55434

# Object storage (S3-compatible). Endpoint is required so the client never defaults to AWS.
S3_ENDPOINT=http://127.0.0.1:55436
S3_REGION=auto
S3_BUCKET=app
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Email — at least one of Resend or SMTP. Composition roots prefer SMTP when SMTP_URL is set.
RESEND_API_KEY=re_test_replace_me
EMAIL_FROM=noreply@example.com
SMTP_URL=smtp://127.0.0.1:55438
MAILPIT_API_URL=http://127.0.0.1:55439

# Auth — Better Auth secret must be ≥32 chars. OAuth optional until those providers are offered.
BETTER_AUTH_SECRET=dev-local-better-auth-secret-min-32-chars
BETTER_AUTH_URL=https://web.localhost
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OpenTelemetry — off by default.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:55445
# OTEL_SERVICE_NAME=app

# Sentry — one project across web/api/worker (filter by the `service` tag).
# Runtime: SENTRY_DSN (server) and NEXT_PUBLIC_SENTRY_DSN (browser).
# CI source maps: SENTRY_ORG, SENTRY_PROJECT, secret SENTRY_AUTH_TOKEN.
SENTRY_ENABLED=false
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=local
# SENTRY_RELEASE=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog — server capture; browser key is NEXT_PUBLIC_*.
# EU cloud uses eu.i.posthog.com; US cloud uses us.i.posthog.com.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Feature flags — JSON object of booleans (PostHog provider used when API key is set).
# FLAGS_JSON={"new-billing-portal":true}

# Stripe Billing. Staging and production reject test keys (sk_test_ / pk_test_).
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Process ports — defaults; set only to override.
# PORT=3000
# HOSTNAME=0.0.0.0
# API_PORT=3001
# WORKER_PORT=3002
# OUTBOX_POLL_MS=1000

# Image builds may set SKIP_ENV_VALIDATION=1 when secrets are absent.
# Never set it at runtime. The migrate job needs base + db only.
# SKIP_ENV_VALIDATION=
