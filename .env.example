# Local laptop catalog. `make setup` copies this to `.env`.
# Used by package CLIs (`make db-migrate`, seeds) and by api/worker via `--env-file`.
# Next.js loads `.env*` from `apps/web/` (copy or symlink this file there).
# Docs has its own file: `apps/docs/.env.example` → `apps/docs/.env` (port 3003).
# Full catalog: docs/architecture/09-environment-and-secrets.md §5
#
# The three `*.example` files list the same keys in the same order; only values
# and which lines are uncommented differ per environment.

NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Public client values — baked into the web / docs images at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# Database (`make db-up` → host port 55432).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/app
DATABASE_POOL_SIZE=10

# Redis (`make deps-up` → host port 55434). Test stack uses 55435.
REDIS_URL=redis://127.0.0.1:55434

# S3 / MinIO (`make deps-up` → API 55436, console 55437).
S3_ENDPOINT=http://127.0.0.1:55436
S3_REGION=auto
S3_BUCKET=app
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Email — at least one of Resend or SMTP. Local SMTP targets Mailpit (55438 / UI 55439);
# composition roots prefer SMTP when SMTP_URL is set. Deployed envs typically set only Resend.
RESEND_API_KEY=re_test_replace_me
EMAIL_FROM=noreply@example.com
SMTP_URL=smtp://127.0.0.1:55438
MAILPIT_API_URL=http://127.0.0.1:55439

# Auth — Better Auth secret must be ≥32 chars. OAuth optional locally.
BETTER_AUTH_SECRET=dev-local-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OpenTelemetry — off by default for quiet local loops.
# When enabled, point at the local collector (`make deps-up` → OTLP 55444/55445;
# Jaeger UI 55443; Prometheus 55447; Grafana 55448 admin/admin).
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:55445
# OTEL_SERVICE_NAME=app

# Sentry — one project across web/api/worker (filter by the `service` tag).
# Runtime: SENTRY_DSN (server) and NEXT_PUBLIC_SENTRY_DSN (browser).
# CI source maps: SENTRY_ORG, SENTRY_PROJECT, secret SENTRY_AUTH_TOKEN.
SENTRY_ENABLED=false
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=local
# SENTRY_RELEASE=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# PostHog — server capture; browser key is NEXT_PUBLIC_*.
# EU cloud uses eu.i.posthog.com; US cloud uses us.i.posthog.com.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Feature flags — JSON object of booleans for local/dev (PostHog provider used when API key is set).
# FLAGS_JSON={"new-billing-portal":true}

# Stripe Billing (optional locally). Prefer a restricted key (rk_) in live envs;
# test keys (sk_test_ / pk_test_) are rejected when APP_ENV is staging or production.
# Publishable key is client-safe.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Process ports — defaults; set only to override.
# PORT=3000
# HOSTNAME=0.0.0.0
# API_PORT=3001
# WORKER_PORT=3002
# OUTBOX_POLL_MS=1000

# Image builds may set SKIP_ENV_VALIDATION (value 1) when secrets are absent.
# Never set it at runtime. The migrate job needs base + db only.
