# Copy to `.env` at the repository root and fill in.
#
# One file for the whole workspace: `apps/web/next.config.ts` and
# `packages/db/drizzle.config.ts` both load it with Node's built-in
# `process.loadEnvFile`. In production, set these as real environment
# variables instead — nothing reads a file there.

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="development-secret-replace-me-with-32-plus-characters"

# Public origin of the app. Better Auth signs callback URLs with it, so it must
# match the URL the browser actually uses.
BETTER_AUTH_URL="http://localhost:3000"

# Email. Leave RESEND_API_KEY unset and every message is appended to `.mail/`
# and its link printed to the terminal, so verification, password reset, and
# invitations all work without an account. Set it — and point EMAIL_FROM at a
# domain you have verified — in any environment with real users.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="noreply@yourdomain.com"

# Better Auth's per-IP rate limiting. Leave it on anywhere real people sign in;
# the browser test suite sets it to "off" because it comes from one address.
# AUTH_RATE_LIMIT="on"
