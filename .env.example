# Copy to `.env` for local scripts (`make db-migrate`, seeds, integration tests).
# Apps will compose their own env modules; this file is for package CLIs.

NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Public client values (inlined into the Next.js bundle).
# Web uses these from the app dir (`apps/web/.env` or root loaded by tooling).
# Docs has its own file: `apps/docs/.env.example` → `apps/docs/.env` (port 3003).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local


# Dev database (`make db-up` → host port 55432).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/app
DATABASE_POOL_SIZE=10

# Redis (`make deps-up` → host port 55434). Test stack uses 55435.
REDIS_URL=redis://127.0.0.1:55434

# S3 / MinIO (`make deps-up` → API 55436, console 55437).
S3_ENDPOINT=http://127.0.0.1:55436
S3_REGION=auto
S3_BUCKET=app
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Email — Resend in deployed envs; local SMTP targets Mailpit (55438 / UI 55439).
RESEND_API_KEY=re_test_replace_me
EMAIL_FROM=noreply@example.com
SMTP_URL=smtp://127.0.0.1:55438
MAILPIT_API_URL=http://127.0.0.1:55439

# Auth — Better Auth secret must be ≥32 chars. OAuth optional locally.
BETTER_AUTH_SECRET=dev-local-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Observability — off by default for quiet local loops.
# When enabled, point at local collector (`make deps-up` → OTLP 55444/55445; Jaeger UI 55443;
# Prometheus 55447; Grafana 55448 admin/admin).
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:55445
# OTEL_SERVICE_NAME=app

SENTRY_ENABLED=false
# Sentry — error tracking. One project across all apps (distinguished by the `service` tag: web/api/worker).
# Point both SENTRY_DSN (server) and NEXT_PUBLIC_SENTRY_DSN (browser) to your project's DSN.
# (Optional per-service overrides: SENTRY_DSN_API, SENTRY_DSN_WORKER, SENTRY_DSN_WEB).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=local
# SENTRY_RELEASE=local-dev
# SENTRY_ORG=
# SENTRY_PROJECT=
# CI source maps: var SENTRY_PROJECT, var SENTRY_ORG, secret SENTRY_AUTH_TOKEN
# (Optional per-service CI overrides: SENTRY_PROJECT_API, SENTRY_PROJECT_WORKER, SENTRY_PROJECT_WEB)

# PostHog — server capture (api/web/worker ports). Browser key is NEXT_PUBLIC_* below.
# EU cloud uses eu.i.posthog.com; US cloud uses us.i.posthog.com.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Feature flags — JSON overrides for local/dev (PostHog provider used when API key set).
# FLAGS_JSON={"new-billing-portal":true}

# Stripe Billing (optional locally). Prefer a restricted key (rk_) in production;
# sk_test_ keys are rejected when APP_ENV=production. Webhook secret from
# `stripe listen` or the Dashboard. Publishable key is client-safe.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

