# These settings are architecture, not tuning. See ADR-0002.
#
# Isolated node_modules gives each package only its declared dependencies, so an
# undeclared cross-layer import is physically unresolvable rather than merely
# discouraged. Hoisting would silently restore the ability to import anything
# from anywhere and defeat the layer model entirely.
node-linker=isolated
shamefully-hoist=false
hoist=false

# Peer dependencies must be declared deliberately, not guessed at install time.
auto-install-peers=false
strict-peer-dependencies=true

# Reproducibility.
resolution-mode=highest
save-exact=false
prefer-workspace-packages=true
link-workspace-packages=true

# Fail loudly when the lockfile and manifests disagree instead of silently
# resolving something new.
prefer-frozen-lockfile=true

# Keep the store shared and the output readable.
enable-pre-post-scripts=false
