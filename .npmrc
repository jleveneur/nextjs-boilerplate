# Isolated node_modules gives each package only its declared dependencies, so an
# import of something a package never declared is unresolvable rather than
# merely discouraged. Hoisting would silently restore the ability to import
# anything from anywhere.
node-linker=isolated
shamefully-hoist=false
hoist=false

# Peer dependencies must be declared deliberately, not guessed at install time.
auto-install-peers=false
strict-peer-dependencies=true

# Reproducibility.
resolution-mode=highest
save-exact=false
prefer-workspace-packages=true
link-workspace-packages=true

# Fail loudly when the lockfile and manifests disagree instead of silently
# resolving something new.
prefer-frozen-lockfile=true

# Scripts run because a package.json script names them, never implicitly.
enable-pre-post-scripts=false
