{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check:*)",
      "Bash(make format:*)",
      "Bash(make lint:*)",
      "Bash(make typecheck:*)",
      "Bash(make test:*)",
      "Bash(make layers:*)",
      "Bash(make spell:*)",
      "Bash(make knip:*)",
      "Bash(make react-doctor:*)",
      "Bash(pnpm changeset:*)",
      "Bash(pnpm install:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": ["Read(./.env)", "Read(./**/.env)", "Read(./**/.env.local)"]
  }
}
